{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // `next build` and `next typegen` both write `.next/types`; running
      // them in parallel races. Typecheck first, then build.
      "dependsOn": ["$TURBO_EXTENDS$", "typecheck"]
    }
  }
}
