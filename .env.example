APP_NAME="Planeward Community App"
APP_ENV=local
# Run `php artisan key:generate` after copying this file.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3005

# `php artisan serve` is single-threaded without workers; the iframe loads
# assets and API calls in parallel.
PHP_CLI_SERVER_WORKERS=4

# App id from Planeward Developer settings; viewer tokens must have this `aud`.
PLANEWARD_APP_ID=""
# App secret (pwa_...) used to call the Planeward API. Server only.
PLANEWARD_APP_SECRET=""
# Webhook signing secret used to verify x-planeward-signature. Server only.
PLANEWARD_WEBHOOK_SECRET=""
# Planeward deployment that issues tokens and serves the API.
PLANEWARD_BASE_URL="https://app.planeward.com"

# Postgres from compose.yml (host port 5433). Needs the pdo_pgsql PHP extension.
DB_CONNECTION=pgsql
DB_URL="pgsql://planeward_app:planeward_app@localhost:5433/planeward_app"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# No sessions or cookies (the app runs in a cross-origin iframe), no queue
# workers, and the JWKS cache lives on disk.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=file
