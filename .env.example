# App id from Planeward Developer settings; viewer tokens must have this `aud`.
PLANEWARD_APP_ID=""
# App secret (pwa_...) used to call the Planeward API. Server only.
PLANEWARD_APP_SECRET=""
# Webhook signing secret used to verify x-planeward-signature. Server only.
PLANEWARD_WEBHOOK_SECRET=""
# Planeward deployment that issues tokens and serves the API.
PLANEWARD_BASE_URL="https://app.planeward.com"
# Dev only: your tunnel hostname(s), comma-separated, no https:// (e.g. "abc-123.trycloudflare.com"). Leave empty in production.
ALLOWED_DEV_ORIGINS=""
# Postgres from compose.yml (host port 5433).
DATABASE_URL="postgres://planeward_app:planeward_app@localhost:5433/planeward_app"
