{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@planeward/app-sdk",
  "version": "0.1.0",
  "description": "Build apps that run inside Planeward communities: iframe handshake, viewer token verification, webhooks, and a typed API client.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enum314/planeward-app-template.git",
    "directory": "packages/app-sdk"
  },
  "prettier": "@repo/prettier-config/node",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "release": "bumpp --commit \"chore(release): app-sdk-v%s\" --tag \"app-sdk-v%s\" --no-push",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-timeout=30000 src/*.test.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.md\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"*.md\""
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "bumpp": "^12.3.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "^0.23.2",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "jose": "^6.2.9"
  }
}
